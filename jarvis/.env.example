# Copy to .env and edit. Every value is optional.

# Brain: "auto" (Claude if ANTHROPIC_API_KEY is set, otherwise Ollama), "claude", or "ollama"
JARVIS_BRAIN=auto

# Claude (paid, smarter). Leave empty to stay 100% free and local.
ANTHROPIC_API_KEY=
JARVIS_CLAUDE_MODEL=claude-opus-5-5
# low = fastest replies, medium/high = smarter but slower
JARVIS_CLAUDE_EFFORT=low

# Ollama (free, on-device). Install from https://ollama.com then: ollama pull qwen2.5:7b
JARVIS_OLLAMA_MODEL=qwen2.5:7b
JARVIS_OLLAMA_URL=http://127.0.0.1:11434
# How long the model stays in RAM after a command. Shorter frees memory sooner;
# the next command after it unloads takes a few seconds longer. On 8 GB Macs keep it short.
JARVIS_OLLAMA_KEEP_ALIVE=5m

# Whisper speech model: tiny, base, small, medium, large-v3 (bigger = more accurate Arabic, slower)
JARVIS_WHISPER_MODEL=small

# Speak replies out loud with macOS `say`
JARVIS_TTS=1

# Local web UI port
JARVIS_PORT=8765
